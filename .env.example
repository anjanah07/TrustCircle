# PayPal sandbox is the default; simulation requires an explicit opt-in.
PAYMENT_MODE=paypal
PORT=3000
DEMO_DB_PATH=./.demo-db

# For PostgreSQL locally or on Render, set the connection string:
# DATABASE_URL=postgresql://trustcircle:trustcircle@localhost:5432/trustcircle
# PGSSL=true  # Only when your database endpoint requires TLS; certificate verification stays on.

# Real API calls to PayPal SANDBOX only. Requires a separate, fresh USD database.
# PAYMENT_MODE=paypal
# APP_URL=https://your-service.onrender.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SECRET=  # Existing alias also supported.
# PAYPAL_WEBHOOK_ID=

# Optional LLM. Without a key, the labeled deterministic demo assistant runs.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano

# Persistent signing identity, PEM with literal \n allowed.
# BADGE_PRIVATE_KEY=

# Single Next.js origin, used for PayPal checkout returns.
APP_URL=https://your-app.example
# Display label only: must match the business account owning PAYPAL_CLIENT_ID.
# TREASURER_PAYPAL_EMAIL=your-business-sandbox@example.com
# New application circles use 30 seconds to contribute + 30 seconds grace.
# Creator-only pause/resume controls are available in Overview.

# Render first deployment only: disables registration, transfers and workers.
# DEPLOYMENT_SETUP=true
# On Render, omit APP_URL to use RENDER_EXTERNAL_URL automatically.

# Only on Render with its private dpg- hostname: encrypted, self-signed TLS.
# PGSSL_MODE=render-internal
# Leave unset for external URLs and local development.

# Isolate PayPal records from older simulation tables in the same database.
DATABASE_SCHEMA=trustcircle_paypal_local
# On Render use DATABASE_SCHEMA=trustcircle_paypal instead.
